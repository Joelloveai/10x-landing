# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://tenx.my

# ---------------------------------------------------------------------------
# Audit form destination (server-side only, never exposed to the browser).
# In production at least ONE destination must be configured, otherwise
# POST /api/waitlist returns 503 instead of pretending the lead was saved.
# ---------------------------------------------------------------------------

# Option A: any webhook that accepts JSON (Make, Zapier, n8n, Slack workflow, etc).
WAITLIST_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Webhook-Secret" header.
WAITLIST_WEBHOOK_SECRET=

# Option B: a 10X lead-ingestion endpoint (full URL).
TENX_API_URL=
# Optional bearer token for TENX_API_URL.
TENX_API_KEY=
